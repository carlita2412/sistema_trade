# Variables de entorno del proyecto en Vercel (Settings -> Environment Variables).
# Para desarrollo local, copia esto a ".env.local".

# URL completa del endpoint de estado en Lightsail, ej: http://TU_IP_PUBLICA:8787/api/state
LIGHTSAIL_API_URL=http://TU_IP_PUBLICA:8787/api/state
# Debe coincidir con API_KEY_SECRET del servidor en Lightsail.
LIGHTSAIL_API_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio

# Password del dashboard (Basic Auth, vía middleware.ts).
DASHBOARD_USER=carla
DASHBOARD_PASSWORD=cambia-esta-clave
