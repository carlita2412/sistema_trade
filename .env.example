# Copia este archivo a ".env" (en la raíz de perp-xrp-signals) y completa los valores.
# El .env nunca se sube a git (ver .gitignore).

# --- Servidor de datos (script original) ---
# Solo necesario si "xrp_dashboard_server - con chekck.py" no está un nivel
# arriba de esta carpeta (ruta por defecto).
# DASHBOARD_SCRIPT_PATH=C:\ruta\a\xrp_dashboard_server - con chekck.py
# DATA_DIR=C:\ruta\a\la\carpeta\con\los\CSV

# --- api/api_server.py (Lightsail) ---
API_PORT=8787
API_HOST=0.0.0.0
# Secreto compartido con dashboard-web (header X-API-Key). Genera uno largo y random.
API_KEY_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio
# Dominio del dashboard en Vercel, para restringir CORS. Usa "*" mientras pruebas.
ALLOWED_ORIGIN=https://tu-app.vercel.app

# --- Alertas Telegram ---
# Crea el bot con @BotFather en Telegram, copia el token que te da.
TELEGRAM_BOT_TOKEN=
# Tu chat_id (habla con @userinfobot o mira la respuesta de getUpdates).
TELEGRAM_CHAT_ID=
